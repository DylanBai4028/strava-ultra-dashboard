# Copy this file to `.env` and fill in your own values.
# Run `src/auth.py` to get the first three automatically — it walks you
# through Strava's OAuth flow and writes them for you.

# Strava API app credentials — register a free app at
# https://www.strava.com/settings/api, then run `src/auth.py`.
STRAVA_CLIENT_ID=
STRAVA_CLIENT_SECRET=
STRAVA_REFRESH_TOKEN=

# Optional — enables an email alert if a scheduled sync fails.
# Use a Gmail App Password (https://myaccount.google.com/apppasswords),
# not your normal account password. Leave blank to skip.
GMAIL_APP_PASSWORD=
